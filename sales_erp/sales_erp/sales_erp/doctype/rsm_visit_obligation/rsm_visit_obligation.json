{
 "autoname": "format:OBL-{YYYY}-{#####}",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "cycle_id",
  "customer",
  "customer_name",
  "territory",
  "assigned_rsm",
  "assigned_asm",
  "col_break_1",
  "cycle_start",
  "due_date",
  "grace_end_date",
  "status",
  "escalation_state",
  "fulfillment_section",
  "qualifying_visit",
  "satisfied_on",
  "satisfied_by",
  "escalation_section",
  "last_escalated_on",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "cycle_id",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Cycle ID",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Retailer",
   "options": "Customer",
   "reqd": 1,
   "search_index": 1
  },
  {
   "fetch_from": "customer.customer_name",
   "fieldname": "customer_name",
   "fieldtype": "Data",
   "in_list_view": 1,
   "label": "Retailer Name",
   "read_only": 1
  },
  {
   "fetch_from": "customer.territory",
   "fieldname": "territory",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Territory",
   "options": "Territory",
   "read_only": 1
  },
  {
   "fieldname": "assigned_rsm",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Assigned RSM",
   "options": "User"
  },
  {
   "fieldname": "assigned_asm",
   "fieldtype": "Link",
   "label": "Assigned ASM",
   "options": "User"
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cycle_start",
   "fieldtype": "Date",
   "label": "Cycle Start",
   "reqd": 1
  },
  {
   "fieldname": "due_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "Target Due Date (Day 80)",
   "reqd": 1
  },
  {
   "fieldname": "grace_end_date",
   "fieldtype": "Date",
   "label": "Grace End Date (Day 85)",
   "reqd": 1
  },
  {
   "default": "Open",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Obligation Status",
   "options": "Open\nSatisfied\nEscalated\nCancelled",
   "reqd": 1
  },
  {
   "default": "None",
   "fieldname": "escalation_state",
   "fieldtype": "Select",
   "label": "Escalation State",
   "options": "None\nApproaching\nGrace\nEscalated"
  },
  {
   "fieldname": "fulfillment_section",
   "fieldtype": "Section Break",
   "label": "Satisfaction Evidence"
  },
  {
   "fieldname": "qualifying_visit",
   "fieldtype": "Link",
   "label": "Qualifying Retailer Visit",
   "options": "Retailer Visit",
   "read_only": 1
  },
  {
   "fieldname": "satisfied_on",
   "fieldtype": "Datetime",
   "label": "Satisfied On",
   "read_only": 1
  },
  {
   "fieldname": "satisfied_by",
   "fieldtype": "Link",
   "label": "Satisfied By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "escalation_section",
   "fieldtype": "Section Break",
   "label": "Escalation Audit"
  },
  {
   "fieldname": "last_escalated_on",
   "fieldtype": "Datetime",
   "label": "Last Escalated On",
   "read_only": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  }
 ],
