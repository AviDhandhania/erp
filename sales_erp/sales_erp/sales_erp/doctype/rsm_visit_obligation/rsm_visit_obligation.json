  },
  {
   "create": 1,
   "delete": 1,
   "export": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "write": 1
  },
  {
   "export": 1,
   "read": 1,
   "report": 1,
   "role": "Clothing Regional Sales Manager"
  },
  {
   "export": 1,
   "read": 1,
   "report": 1,
   "role": "Clothing Area Sales Manager"
  }
 ],
 "sort_field": "due_date",
